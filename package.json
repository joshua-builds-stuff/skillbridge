{
  "name": "skillbridge",
  "version": "0.1.0",
  "description": "Expose live Executor skills on demand in OpenCode V2",
  "type": "module",
  "license": "MIT",
  "repository": {"type": "git", "url": "https://github.com/joshua-builds-stuff/skillbridge.git"},
  "homepage": "https://github.com/joshua-builds-stuff/skillbridge#readme",
  "bugs": {"url": "https://github.com/joshua-builds-stuff/skillbridge/issues"},
  "private": true,
  "exports": "./index.js",
  "types": "./dist/index.d.ts",
  "files": ["index.js", "dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test test",
    "test:entrypoint": "node -e \"import('./index.js').then((module) => { if (!module.default?.id) process.exit(1) })\"",
    "prepack": "npm run typecheck && npm test && npm run build && npm run test:entrypoint"
  },
  "engines": {"node": ">=22"},
  "peerDependencies": {"@opencode/plugin": ">=2.0.17 <3"},
  "dependencies": {"zod": "4.6.5"},
  "devDependencies": {
    "@opencode/plugin": "2.0.17",
    "@types/bun": "1.3.10",
    "@types/node": "22.19.7",
    "typescript": "5.9.3"
  }
}
